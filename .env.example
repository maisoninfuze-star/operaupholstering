# Copier vers ../.env (hors dépôt) et remplir. Ne jamais committer la vraie clé.
FAL_KEY=<uuid>:<hex>

# ─── Éditeur en ligne (/admin.html) ───────────────────────────────
# À régler dans Vercel → Settings → Environment Variables.
# Sans elles, l'éditeur fonctionne quand même : il rend un .zip.
ADMIN_PASSCODE=<le mot de passe de l'atelier>
ADMIN_SESSION_SECRET=<32+ caractères au hasard, ex. openssl rand -base64 32>
GITHUB_TOKEN=<jeton fine-grained, Contents read/write sur ce dépôt seulement>
GITHUB_REPO=maisoninfuze-star/operaupholstering
GITHUB_BRANCH=main

# ─── Envoi direct des estimations (photos comprises) ──────────────
# Compte gratuit sur resend.com; sans cette clé, le formulaire ouvre
# l'application de courriel du visiteur (sans pièces jointes).
RESEND_API_KEY=<clé re_…>
# Expéditeur : onboarding@resend.dev fonctionne sans configuration;
# une adresse du domaine exige de vérifier le domaine chez Resend.
EMAIL_FROM=Opera Upholstering <onboarding@resend.dev>
# Destinataires (défauts : les deux adresses contact du site)
# ESTIMATE_TO_FR=contact@operarembourrage.ca
# ESTIMATE_TO_EN=contact@operaupholstering.ca
